# Copy this file to `.env` for local development and fill in real values.
# Never commit a populated `.env` or any secret.

# --- Application ---
APP_ENV=development
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+psycopg://civic:civic@localhost:5432/civic_evidence

# --- Object / file storage ---
AUDIO_STORAGE_BACKEND=local
AUDIO_STORAGE_DIR=./data/raw/audio
DOCUMENT_STORAGE_DIR=./data/processed/documents
MAX_UPLOAD_MB=200

# --- N-ATLAS model access ---
N_ATLAS_BASE_URL=
N_ATLAS_API_KEY=
N_ATLAS_MODEL_ID=
N_ATLAS_TIMEOUT_SECONDS=60

# --- Civic knowledge retrieval ---
CIVIC_INDEX_DIR=./data/processed/civic_index

# --- Web application ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
