# Copy this file to `.env` for local development and fill in real values.
# Never commit a populated `.env` or any secret.

# --- Application ---
# For production, set APP_ENV=production and replace SECRET_KEY with a 32+ character secret.
APP_ENV=development
SECRET_KEY=dev-secret-key-change-me-please-123456
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite:////Users/Omistaja/Documents/n-atlas-civic-evidence/data/civic_evidence.db

# --- Object / file storage ---
AUDIO_STORAGE_BACKEND=local
AUDIO_STORAGE_DIR=./data/raw/audio
DOCUMENT_STORAGE_DIR=./data/processed/documents
MAX_UPLOAD_MB=200

# --- N-ATLAS model access ---
N_ATLAS_BASE_URL=
N_ATLAS_API_KEY=
N_ATLAS_MODEL_ID=
N_ATLAS_TIMEOUT_SECONDS=60

# --- Civic knowledge retrieval ---
CIVIC_INDEX_DIR=./data/processed/civic_index

# --- Web application ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
