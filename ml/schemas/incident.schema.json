{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://n-atlas.example/schemas/incident.schema.json",
  "title": "IncidentClassification",
  "type": "object",
  "required": ["incident_type", "source_segment_id", "status"],
  "additionalProperties": false,
  "properties": {
    "incident_id": { "type": "string" },
    "incident_type": {
      "type": "string",
      "enum": ["procedural", "access", "intimidation", "documentation", "other"]
    },
    "description": { "type": ["string", "null"] },
    "occurred_at": { "type": ["string", "null"] },
    "jurisdiction": { "type": ["string", "null"] },
    "source_segment_id": { "type": "string" },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "status": {
      "type": "string",
      "enum": ["unverified", "accepted", "edited", "rejected", "flagged"]
    }
  }
}
